[Unit]
Description=CONFIDIS Node
Documentation=https://confidis.eu/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=confidis
Group=confidis
WorkingDirectory=/var/confidis
ExecStart=/opt/confidis/bin/confidis node serve /etc/confidis/node.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Harden the service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/confidis /etc/confidis /var/www/confidis-ui
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
